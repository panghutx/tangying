generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String?
  name         String?
  image        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assets       Asset[]
  accounts     FinancialAccount[]
  transactions Transaction[]
  weeklyProfits WeeklyProfit[]
  holdings     Holding[]
  marketIndicatorSnapshots MarketIndicatorSnapshot[]
  marketBriefings MarketBriefing[]

  @@map("users")
}

model FinancialAccount {
  id                  String        @id @default(cuid())
  userId              String
  name                String
  type                AccountType
  platform            String
  credentials         String?
  currency            String        @default("CNY")
  cashBalance         Decimal?      @db.Decimal(15, 2)
  cashCurrency        String?
  includeInProfit     Boolean       @default(true)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  assets              Asset[]
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncLogs            SyncLog[]
  transactions        Transaction[]
  relatedTransactions Transaction[] @relation("TransferRelation")
  weeklyProfits       WeeklyProfit[]
  holdings            Holding[]

  @@map("financial_accounts")
}

model Security {
  id          String         @id @default(cuid())
  symbol      String
  name        String
  market      SecurityMarket
  bucket      AssetBucket
  currency    String
  quoteSource String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  holdings    Holding[]
  priceQuotes PriceQuote[]

  @@unique([symbol, market])
  @@map("securities")
}

model Holding {
  id           String           @id @default(cuid())
  userId       String
  accountId    String
  securityId   String
  quantity     Decimal          @db.Decimal(20, 6)
  costAmount   Decimal          @db.Decimal(15, 2)
  costCurrency String
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  security     Security         @relation(fields: [securityId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, securityId])
  @@index([userId])
  @@map("holdings")
}

model PriceQuote {
  id         String   @id @default(cuid())
  securityId String
  price      Decimal  @db.Decimal(18, 6)
  currency   String
  quotedAt   DateTime
  source     String
  createdAt  DateTime @default(now())
  security   Security @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@index([securityId, quotedAt])
  @@map("price_quotes")
}

model MarketIndicatorSnapshot {
  id         String   @id @default(cuid())
  userId     String
  symbol     String
  name       String
  category   String
  value      Decimal  @db.Decimal(18, 6)
  changePct  Decimal? @db.Decimal(10, 4)
  currency   String?
  source     String
  observedAt DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, observedAt])
  @@index([userId, symbol, observedAt])
  @@map("market_indicator_snapshots")
}

model MarketBriefing {
  id               String   @id @default(cuid())
  userId           String
  status           String
  marketTemperature String
  summary          String
  keyChanges       Json
  affectedBuckets  Json
  reviewQuestions  Json
  uncertainties    Json
  signals          Json
  sourceSnapshot   Json
  model            String?
  observedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, observedAt])
  @@map("market_briefings")
}

model Asset {
  id        String           @id @default(cuid())
  accountId String
  userId    String
  date      DateTime         @db.Date
  amount    Decimal          @db.Decimal(15, 2)
  currency  String           @default("CNY")
  note      String?
  source    AssetSource      @default(MANUAL)
  breakdown Json?
  createdAt DateTime         @default(now())
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@map("assets")
}

model SyncLog {
  id        String           @id @default(cuid())
  accountId String
  status    SyncStatus
  message   String?
  syncedAt  DateTime         @default(now())
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("sync_logs")
}

model Transaction {
  id               String            @id @default(cuid())
  accountId        String
  userId           String
  date             DateTime          @db.Date
  amount           Decimal           @db.Decimal(15, 2)
  type             TransactionType
  category         String?
  note             String?
  relatedAccountId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  account          FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  relatedAccount   FinancialAccount? @relation("TransferRelation", fields: [relatedAccountId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([userId, date])
  @@map("transactions")
}

model WeeklyProfit {
  id              String   @id @default(cuid())
  userId          String
  accountId       String
  weekStartDate   DateTime @db.Date
  weekEndDate     DateTime @db.Date

  startAsset      Decimal  @db.Decimal(15, 2)
  endAsset        Decimal  @db.Decimal(15, 2)
  startAssetDate  DateTime?
  endAssetDate    DateTime?

  totalDeposit    Decimal  @db.Decimal(15, 2)
  totalWithdraw   Decimal  @db.Decimal(15, 2)
  totalTransferIn Decimal  @db.Decimal(15, 2)
  totalTransferOut Decimal @db.Decimal(15, 2)
  totalIncome     Decimal  @db.Decimal(15, 2)

  netInflow       Decimal  @db.Decimal(15, 2)
  realProfit      Decimal  @db.Decimal(15, 2)
  profitRate      Decimal  @db.Decimal(10, 4)

  currency        String
  hasValidData    Boolean  @default(true)

  createdAt       DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, weekStartDate])
  @@index([userId, weekStartDate])
  @@map("weekly_profits")
}

enum AccountType {
  DOMESTIC
  BANK
  BROKERAGE
  OVERSEAS
}

enum SyncStatus {
  SUCCESS
  FAILED
  PENDING
}

enum TransactionType {
  INCOME
  DEPOSIT
  WITHDRAW
  TRANSFER_IN
  TRANSFER_OUT
}

enum AssetSource {
  MANUAL
  AUTO_HOLDINGS
  AUTO_MIXED
}

enum SecurityMarket {
  US_STOCK
  US_ETF
  CN_FUND
  CN_ETF
  HK_STOCK
  CASH
  OTHER
}

enum AssetBucket {
  CASH
  SP500_GLOBAL
  NASDAQ_TECH
  ACTIVE_TECH_AI
  CHINA_INTERNET
  CN_HK_EQUITY
  GOLD_RESOURCE
  BOND_INCOME
  OTHER
}
